# Optional: start one server-owned WhatsApp account automatically.
# Leave empty when all users should pair their own WhatsApp numbers through the website.
PRIMARY_PHONE=

# Optional persistent auth directory. On Render, point this at a mounted persistent disk if you have one.
# WA_AUTH_DIR=/var/data/terminal-vast/sessions

# Optional database connection used by existing bot code.
DATABASE_URL=

# Optional port; Render supplies PORT automatically.
PORT=
